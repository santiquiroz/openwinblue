<UserControl x:Class="OpenWinBlue.Views.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="HFP &amp; AI Controls" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>

        <!-- HFP Guard -->
        <TextBlock Text="HFP Guard" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox Content="Prevent automatic HFP switching (keep A2DP stereo active)"
                  IsChecked="{Binding HfpGuardEnabled, Mode=TwoWay}"
                  Margin="0,0,0,4"/>
        <TextBlock Text="{Binding HfpGuardNote}"
                   Foreground="#666" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- HFP Level 1 — stop/disable BthHFSrv service -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Disable HFP Profile (Level 1)"
                    Command="{Binding DisableHfpLevel1Command}"
                    ToolTip="Stops BthHFSrv — prevents automatic HFP switching. Requires admin."
                    Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Re-enable HFP Profile"
                    Command="{Binding EnableHfpLevel1Command}"
                    ToolTip="Restores BthHFSrv to normal operation."
                    Padding="10,4"/>
        </StackPanel>

        <!-- AI Enhancement -->
        <TextBlock Text="AI Audio Enhancement" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox Content="AI Noise Reduction (RNNoise — CPU, ~10ms latency)"
                  IsChecked="{Binding NoiseReduction, Mode=TwoWay}"
                  Margin="0,0,0,4"/>
        <CheckBox Content="DeepFilterNet3 (ONNX Runtime + DirectML — requires deepfilter.onnx)"
                  IsChecked="{Binding DeepFilter, Mode=TwoWay}"
                  ToolTip="Place deepfilter.onnx next to owb-service.exe to enable GPU-accelerated noise suppression."
                  Margin="0,0,0,4"/>
        <CheckBox Content="Smart Adaptive Bitrate"
                  IsChecked="{Binding AdaptiveBitrate, Mode=TwoWay}"
                  IsEnabled="False"
                  Margin="0,0,0,4"/>
    </StackPanel>
</UserControl>
